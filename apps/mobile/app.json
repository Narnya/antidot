{
  "expo": {
    "name": "Antidot",
    "slug": "antidot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "socialevents",
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "space.antidot.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "space.antidot.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "4d1773a5-de09-4817-a6cf-f2a8aadf7986"
      }
    },
    "owner": "ilnas-team"
  }
}
